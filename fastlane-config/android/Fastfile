require "tmpdir"
require "fileutils"

default_platform(:android)

platform :android do
  desc "Upload a release AAB to Google Play"
  lane :upload_aab do |options|
    track = options[:track] || ENV["GOOGLE_PLAY_TRACK"] || "production"
    package_name = options[:package_name] || ENV["ANDROID_PACKAGE_NAME"] || "jp.nonbili.nora"
    aab_path = options[:aab] || ENV["AAB_PATH"] || File.expand_path("../../android/app/build/outputs/bundle/release/app-release.aab", __dir__)
    metadata_path = options[:metadata_path] || ENV["GOOGLE_PLAY_METADATA_PATH"] || File.expand_path("../../fastlane/metadata/android", __dir__)
    json_key = options[:json_key] || ENV["GOOGLE_PLAY_JSON_KEY"] || ENV["SUPPLY_JSON_KEY"]
    json_key_data = options[:json_key_data] || ENV["GOOGLE_PLAY_JSON_KEY_DATA"] || ENV["SUPPLY_JSON_KEY_DATA"]
    upload_metadata = ENV["GOOGLE_PLAY_UPLOAD_METADATA"] == "1"
    upload_changelogs = ENV["GOOGLE_PLAY_UPLOAD_CHANGELOGS"] != "0"

    UI.user_error!("AAB not found: #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Set GOOGLE_PLAY_JSON_KEY or SUPPLY_JSON_KEY to the service account JSON file path") if json_key.to_s.empty? && json_key_data.to_s.empty?

    upload_to_play_store(
      package_name: package_name,
      json_key: json_key,
      json_key_data: json_key_data,
      aab: aab_path,
      track: track,
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_metadata: !upload_metadata,
      skip_upload_changelogs: !upload_changelogs,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Set the English Google Play preview video"
  lane :upload_video do
    Dir.mktmpdir("nora-play-video-") do |metadata_path|
      locale_path = File.join(metadata_path, "en-US")
      FileUtils.mkdir_p(locale_path)
      FileUtils.cp(File.expand_path("../../metadata/en-US/video.txt", __dir__), locale_path)
      upload_to_play_store(
        package_name: ENV["ANDROID_PACKAGE_NAME"] || "jp.nonbili.nora",
        json_key: ENV["GOOGLE_PLAY_JSON_KEY"] || ENV["SUPPLY_JSON_KEY"],
        json_key_data: ENV["GOOGLE_PLAY_JSON_KEY_DATA"] || ENV["SUPPLY_JSON_KEY_DATA"],
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: false,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        metadata_path: metadata_path
      )
    end
  end

  # F-Droid locale directories in metadata/ and their Google Play language codes
  PLAY_LOCALES = {
    "ar" => "ar", "de" => "de-DE", "el" => "el-GR", "en-US" => "en-US", "es" => "es-ES",
    "et" => "et", "fr" => "fr-FR", "hu" => "hu-HU", "id" => "id", "it" => "it-IT",
    "ja" => "ja-JP", "ko" => "ko-KR", "lv" => "lv", "pl" => "pl-PL", "pt-BR" => "pt-BR",
    "pt-PT" => "pt-PT", "ru" => "ru-RU", "sv" => "sv-SE", "tr" => "tr-TR", "uk" => "uk",
    "vi" => "vi", "zh-Hans" => "zh-CN", "zh-Hant" => "zh-TW"
  }

  desc "Upload the title, short and full descriptions from metadata/ to Google Play"
  lane :upload_listing do
    source = File.expand_path("../../metadata", __dir__)
    en_title = File.read(File.join(source, "en-US", "title.txt")).strip
    # The shared F-Droid tree uses HTML and locale names Play does not accept.
    # Stage plain text under Play language codes instead.
    Dir.mktmpdir("nora-play-listing-") do |metadata_path|
      PLAY_LOCALES.each do |locale, language|
        full_path = File.join(source, locale, "full_description.txt")
        next unless File.exist?(full_path)
        target = File.join(metadata_path, language)
        FileUtils.mkdir_p(target)
        title_path = File.join(source, locale, "title.txt")
        File.write(File.join(target, "title.txt"), File.exist?(title_path) ? File.read(title_path).strip : en_title)
        File.write(File.join(target, "short_description.txt"), File.read(File.join(source, locale, "short_description.txt")).strip)
        full = File.read(full_path)
          .gsub(%r{<h2>(.*?)</h2>}) { "\n#{$1}\n" }
          .gsub(%r{<li>(.*?)</li>}) { "• #{$1}\n" }
          .gsub(%r{<p>(.*?)</p>}) { "#{$1}\n" }
          .gsub(%r{</?ul>}, "")
          .gsub(/\n{3,}/, "\n\n")
          .strip
        File.write(File.join(target, "full_description.txt"), full)
      end
      upload_to_play_store(
        package_name: ENV["ANDROID_PACKAGE_NAME"] || "jp.nonbili.nora",
        json_key: ENV["GOOGLE_PLAY_JSON_KEY"] || ENV["SUPPLY_JSON_KEY"],
        json_key_data: ENV["GOOGLE_PLAY_JSON_KEY_DATA"] || ENV["SUPPLY_JSON_KEY_DATA"],
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: false,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        metadata_path: metadata_path
      )
    end
  end

  desc "Upload screenshots to Google Play Store"
  lane :upload_screenshots do
    # The shared F-Droid tree includes locale names Play does not accept.
    # Stage only the English screenshots for this upload.
    Dir.mktmpdir("nora-play-screenshots-") do |metadata_path|
      images_path = File.join(metadata_path, "en-US", "images")
      FileUtils.mkdir_p(images_path)
      FileUtils.cp_r(
        File.expand_path("../../metadata/en-US/images/phoneScreenshots", __dir__),
        images_path
      )
      upload_to_play_store(
        package_name: ENV["ANDROID_PACKAGE_NAME"] || "jp.nonbili.nora",
        json_key: ENV["GOOGLE_PLAY_JSON_KEY"] || ENV["SUPPLY_JSON_KEY"],
        json_key_data: ENV["GOOGLE_PLAY_JSON_KEY_DATA"] || ENV["SUPPLY_JSON_KEY_DATA"],
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: false,
        metadata_path: metadata_path
      )
    end
  end
end
